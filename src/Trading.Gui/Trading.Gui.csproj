<Project Sdk="Microsoft.NET.Sdk">
  <!-- Task 2 final product: a window showing the latest traded price for each stock. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>tradingGui</AssemblyName>
    <RootNamespace>Pbt205.Trading.Gui</RootNamespace>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <!-- Lets the project build on non-Windows machines too (our CI-style checks). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pbt205.Trading\Pbt205.Trading.csproj" />
  </ItemGroup>
</Project>
