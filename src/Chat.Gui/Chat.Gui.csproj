<Project Sdk="Microsoft.NET.Sdk">
  <!-- Task 1 final product: a chat window with login and a choice of rooms. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>chatGui</AssemblyName>
    <RootNamespace>Pbt205.Chat.Gui</RootNamespace>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <!-- Lets the project build on non-Windows machines too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pbt205.Chat\Pbt205.Chat.csproj" />
  </ItemGroup>
</Project>
